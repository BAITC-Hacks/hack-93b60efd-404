{
  "meta": {
    "dataset": "Voice Router - Saqta Insurance",
    "version": "1.0",
    "as_of_date": "2026-10-01"
  },
  "queues": [
    "operator_general",
    "claims_team",
    "medical_assistance_24_7",
    "corporate_sales",
    "complaints_team",
    "security_team"
  ],
  "error_format": {
    "error": {
      "code": "not_found",
      "message": "Client with phone +77010000099 not found"
    }
  },
  "error_codes": {
    "not_found": "No record matches the input (unknown phone, IIN, policy, claim, plate or payment).",
    "invalid_input": "Input does not match the slot format or allowed values.",
    "policy_inactive": "Policy is expired or not yet active, the operation is not allowed.",
    "not_eligible": "Product rules do not allow it (e.g. car too old for CASCO, traveler over 75).",
    "not_covered": "The service is not covered by the client's DMS package.",
    "no_availability": "No free slots for the requested date; return the nearest alternatives.",
    "already_done": "The operation was already performed (e.g. policy already cancelled).",
    "service_unavailable": "Mock backend is temporarily unavailable; retry once, then hand off."
  },
  "error_handling": [
    "not_found / invalid_input: re-ask the slot once, then offer another identifier or an operator.",
    "policy_inactive / not_eligible / not_covered: explain the reason in one sentence and offer the nearest valid option.",
    "no_availability: offer the nearest free slots.",
    "service_unavailable: retry once, then hand off with context."
  ],
  "actions": [
    {
      "name": "find_client",
      "description": "Find a client by phone or IIN",
      "inputs": [
        "phone|iin"
      ],
      "outputs": [
        "client_id",
        "full_name"
      ],
      "errors": [
        "not_found",
        "invalid_input"
      ],
      "irreversible": false
    },
    {
      "name": "get_policies",
      "description": "List client policies",
      "inputs": [
        "client_id"
      ],
      "outputs": [
        "policies"
      ],
      "errors": [
        "not_found"
      ],
      "irreversible": false
    },
    {
      "name": "get_policy",
      "description": "Get a policy by number or vehicle plate",
      "inputs": [
        "policy_number|vehicle_plate"
      ],
      "outputs": [
        "policy_number",
        "product",
        "status",
        "end_date"
      ],
      "errors": [
        "not_found",
        "invalid_input"
      ],
      "irreversible": false
    },
    {
      "name": "get_bm_class",
